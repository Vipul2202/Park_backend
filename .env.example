# Copy to .env for local dev. On Render, set these in
# Dashboard → your service → Environment instead.

# Render injects PORT automatically — leave unset in production.
PORT=5000
NODE_ENV=development

# JWT — generate fresh values for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Razorpay — dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_me

# Platform Settings
PLATFORM_COMMISSION_PCT=15
GST_PCT=18
PLATFORM_FEE_FLAT=15

# CORS — comma-separated. Requests with no Origin (the Expo/native app)
# are always allowed; this list is for browsers (the admin dashboard).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006
